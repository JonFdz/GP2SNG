{
  "name": "gp2sng",
  "version": "1.1.0",
  "private": true,
  "description": "Convert Guitar Pro files to YARG .sng charts",
  "license": "GPL-3.0-or-later",
  "author": "Alexander Celeste & Jon Fernández",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "build": {
    "appId": "com.gp2sng.app",
    "productName": "GP2SNG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "DISTRIBUTION_NOTICES.txt",
        "to": "DISTRIBUTION_NOTICES.txt"
      },
      {
        "from": "THIRD_PARTY_LICENSES",
        "to": "THIRD_PARTY_LICENSES"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "GP2SNG-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "GP2SNG-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "GP2SNG-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wasm-media-encoders": "^0.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
